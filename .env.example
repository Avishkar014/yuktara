# Environment variables refer to the .env file at the root of the project.
# See the documentation for each framework for more details on how to use them.

# ====================
# Application
# ====================
APP_NAME=talent-marketplace
APP_ENV=development
APP_URL=http://localhost:3000
APP_DEBUG=true
APP_LOG_LEVEL=debug

# ====================
# Server
# ====================
PORT=3000
HOST=0.0.0.0

# ====================
# Database
# ====================
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=talent_marketplace
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here

# ====================
# PostgreSQL Connection Pool
# ====================
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POLE_ACQUIRE_TIMEOUT=30000

# ====================
# Redis
# ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# ====================
# JWT Authentication
# ====================
JWT_SECRET=your_jwt_secret_key_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ====================
# CORS
# ====================
CORS_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ====================
# File Upload
# ====================
UPLOAD_MAX_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR=uploads

# ====================
# Email (SendGrid)
# ====================
EMAIL_FROM=no-reply@talent-marketplace.com
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_RESET_TOKEN_EXPIRES_IN=1h

# ====================
# OAuth (Optional)
# ====================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ====================
# Application Features
# ====================
FEATURE_SKILL_GAP_ANALYSIS=true
FEATURE_PROJECT_ALLOCATION=true
FEATURE_AUDIT_LOGGING=true
FEATURE_SELF_SERVICE=true
FEATURE_ANALYTICS=true

# ====================
# Rate Limiting
# ==================>
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX=100  # per 15 minutes per IP

# ====================
# Security
# ====================
BCRYPT_SALT_ROUNDS=12
SESSION_TIMEOUT_MINUTES=30
CSRF_SECRET=your_csrf_secret_key

# ====================
# Monitoring
# ====================
SENTRY_DSN=your_sentry_dsn_here
NODE_ENV=development
